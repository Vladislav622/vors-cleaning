# Строка подключения к PostgreSQL (Neon, Supabase, свой сервер)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Пароль владельца для первого входа (от 10 символов). После смены в кабинете хранится только хеш в БД.
ADMIN_PASSWORD=change-me-please
# Публичный адрес сайта (для sitemap, robots и проверки Origin)
APP_URL=https://example.com
